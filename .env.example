# Copie para .env.local e preencha.
# Local: os valores aparecem ao rodar `supabase start` (ou `supabase status`).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SOMENTE SERVIDOR — ignora RLS. Nunca exponha no client.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio raiz. Tenants ficam em <slug>.<ROOT_DOMAIN>.
# Local: localhost:3000  →  demo-a.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Fase 1, etapa 10 (notificações) — ainda não usados
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@dominio.com.br
